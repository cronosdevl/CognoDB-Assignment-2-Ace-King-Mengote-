# ---------------------------------------------------------------------------
# Wayfinder — environment configuration
#
# Copy this file to `.env` and fill in the values from the CognoDB console.
# `.env` is gitignored; connection details must never be committed.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- CognoDB (Bolt) --------------------------------------------------------
# Connection URI from console.cognodb.com (Instances -> your instance -> Connect).
# Use the bolt+s:// scheme for the managed cloud instance (TLS); the Bolt port
# is 7687. Local Neo4j/Memgraph dev would use bolt:// instead.
COGNODB_URI=bolt+s://<instance-id>.<region>.databases.cognodb.com:7687

# Default user created with every CognoDB instance.
COGNODB_USER=cognodb

# Shown exactly once at instance creation — copy it then, it cannot be re-read.
COGNODB_PASSWORD=

# Database name. CognoDB free (c0) instances expose a single database.
COGNODB_DATABASE=neo4j

# --- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
# The Vite dev server runs on 5173; add your deployed client origin in prod.
CORS_ORIGIN=http://localhost:5173

# --- Client ----------------------------------------------------------------
# Base URL the browser uses to reach the API. Leave empty in development to
# use the Vite proxy (/api -> http://localhost:4000).
VITE_API_BASE_URL=
